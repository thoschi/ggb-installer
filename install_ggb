cat > "$BASE/start.sh" <<'SHEOF'
#!/bin/bash

BASE="/opt/geogebra"

CHROME="/opt/chrome/chrome"
SERVER="$BASE/server.py"
WWW="$BASE/www"

PROFILE="$HOME/.local/share/geogebra/chrome"
STATE="$HOME/.local/share/geogebra"

PORT="8765"

START_FILE="${1:-}"

SERVER_PID=""
WINDOW_PID=""


cleanup() {

   if [ -n "$WINDOW_PID" ]; then
      kill "$WINDOW_PID" 2>/dev/null || true
      wait "$WINDOW_PID" 2>/dev/null || true
   fi

   if [ -n "$SERVER_PID" ]; then
      kill "$SERVER_PID" 2>/dev/null || true
   fi

}


trap cleanup EXIT INT TERM


if [ ! -x "$CHROME" ]; then
   echo "FEHLER: Chrome fehlt."
   exit 1
fi


if [ ! -x "$SERVER" ]; then
   echo "FEHLER: GeoGebra-Webserver fehlt."
   exit 1
fi


mkdir -p "$PROFILE"

# Eindeutige Dateinamen vermeiden alte Dateiinhalte bei wiederholtem Öffnen.
REQUEST_ID="$(python3 -c 'import uuid; print(uuid.uuid4().hex)')"
OPEN_FILE=""
if [ -n "$START_FILE" ]; then
   if [ ! -f "$START_FILE" ]; then
      echo "FEHLER: Datei nicht gefunden: $START_FILE"
      exit 1
   fi
   TARGET="$WWW/open/${UID}-${REQUEST_ID}.ggb"
   cp -- "$START_FILE" "$TARGET" || exit 1
   chmod 644 "$TARGET"
   OPEN_FILE="open/${UID}-${REQUEST_ID}.ggb"
fi

python3 - "$WWW/open/${UID}-request.json" "$REQUEST_ID" "$OPEN_FILE" <<'PYEOF'
import json
import sys
from pathlib import Path
path = Path(sys.argv[1])
temporary = path.with_name(path.name + '.' + sys.argv[2] + '.tmp')
temporary.write_text(json.dumps({'id': sys.argv[2], 'file': sys.argv[3]}))
temporary.replace(path)
PYEOF

# Ein Starter pro Benutzer: Chrome reicht neue Aufrufe sonst an einen
# vorhandenen Prozess weiter und der zweite Starter beendet seinen Server.
exec 9>"$STATE/launcher.lock"
if ! flock -n 9; then
   echo "Öffnungsanfrage an das laufende GeoGebra übergeben."
   exit 0
fi


# ============================================================
# Server
# ============================================================

"$SERVER" \
   >"/tmp/geogebra-server-${UID}.log" \
   2>&1 &

SERVER_PID=$!

# Chrome erst starten, wenn die lokale Seite tatsächlich erreichbar ist.
if ! python3 - "$SERVER_PID" "$PORT" <<'PYEOF'
import os
import sys
import time
import urllib.request
pid, port = map(int, sys.argv[1:])
deadline = time.monotonic() + 10
while time.monotonic() < deadline:
   try:
      os.kill(pid, 0)
      with urllib.request.urlopen(f'http://127.0.0.1:{port}/', timeout=0.5) as response:
         if response.status == 200:
            sys.exit(0)
   except (OSError, ValueError):
      pass
   time.sleep(0.1)
sys.exit('GeoGebra-Webserver ist nicht bereit; siehe /tmp/geogebra-server-*.log')
PYEOF
then
   exit 1
fi


# ============================================================
# URL
# ============================================================

URL="http://127.0.0.1:${PORT}/?user=${UID}&request=${REQUEST_ID}"


if [ -n "$OPEN_FILE" ]; then
   URL="$URL&file=$OPEN_FILE"
fi


# ============================================================
# Chrome
#
# Absichtlich:
#
# - kein temporäres Profil
# - kein --disk-cache-dir
# - keine Cache-Löschung
# - keine Cache-Löschung beim Neustart
# ============================================================

WINDOW_ARGS=()
if [ -f "$STATE/window.json" ]; then
   mapfile -t WINDOW_ARGS < <(python3 "$BASE/window_state.py" --arguments "$STATE/window.json")
fi

"$CHROME" \
   --ozone-platform=x11 \
   --no-sandbox \
   --password-store=basic \
   --disable-infobars \
   --no-first-run \
   --no-default-browser-check \
   --user-data-dir="$PROFILE" \
   --class=geogebra-local \
   "${WINDOW_ARGS[@]}" \
   --app="$URL" &

CHROME_PID=$!
python3 "$BASE/window_state.py" --watch "$STATE/window.json" "$CHROME_PID" &
WINDOW_PID=$!
wait "$CHROME_PID"


# ============================================================
# Server unmittelbar beenden
# ============================================================

kill "$SERVER_PID" 2>/dev/null || true

SERVER_PID=""


exit 0
SHEOF

chmod 755 "$BASE/start.sh"

# X11-Fensterzustand unabhängig von Chromes App-URL und Cache speichern.
cat > "$BASE/window_state.py" <<'PYEOF'
#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path


def arguments(path):
   try:
      state = json.loads(Path(path).read_text())
      x, y, width, height = (state[key] for key in ("x", "y", "width", "height"))
      if not all(type(value) is int for value in (x, y, width, height)):
         return []
      if not (200 <= width <= 32768 and 200 <= height <= 32768):
         return []
      return [f"--window-position={x},{y}", f"--window-size={width},{height}"]
   except (OSError, ValueError, KeyError, TypeError):
      return []


def window_state():
   clients = subprocess.check_output(["xprop", "-root", "_NET_CLIENT_LIST"], text=True, stderr=subprocess.DEVNULL)
   for window in re.findall(r"0x[0-9a-fA-F]+", clients):
      props = subprocess.check_output(["xprop", "-id", window, "WM_CLASS", "_NET_WM_STATE", "_NET_FRAME_EXTENTS"], text=True, stderr=subprocess.DEVNULL)
      if '"geogebra-local"' not in props:
         continue
      # Nicht die maximierten Abmessungen als normale Fenstergröße speichern.
      if "_NET_WM_STATE_MAXIMIZED" in props or "_NET_WM_STATE_FULLSCREEN" in props:
         continue
      info = subprocess.check_output(["xwininfo", "-id", window], text=True, stderr=subprocess.DEVNULL)
      labels = ("Absolute upper-left X", "Absolute upper-left Y", "Width", "Height")
      values = [int(re.search(re.escape(label) + r":\s*(-?\d+)", info).group(1)) for label in labels]
      frame = re.search(r"_NET_FRAME_EXTENTS\([^)]*\) = (\d+), (\d+), (\d+), (\d+)", props)
      if frame:
         left, right, top, bottom = map(int, frame.groups())
         values = [values[0] - left, values[1] - top, values[2] + left + right, values[3] + top + bottom]
      return dict(zip(("x", "y", "width", "height"), values))
   return None


def watch(path, pid):
   previous = None
   while True:
      try:
         os.kill(pid, 0)
      except ProcessLookupError:
         return
      try:
         state = window_state()
         if state and state != previous:
            temporary = Path(str(path) + ".tmp")
            temporary.write_text(json.dumps(state))
            temporary.replace(path)
            previous = state
      except (OSError, subprocess.SubprocessError, AttributeError, ValueError) as error:
         print(f"Fensterzustand konnte nicht ermittelt werden: {error}", file=sys.stderr)
      time.sleep(0.25)


if __name__ == "__main__":
   if sys.argv[1] == "--arguments":
      print("\n".join(arguments(sys.argv[2])))
   elif sys.argv[1] == "--watch":
      watch(Path(sys.argv[2]), int(sys.argv[3]))
