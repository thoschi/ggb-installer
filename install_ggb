#!/bin/bash

set -e

BASE="/opt/geogebra"
GGB="$BASE/ggb"
WWW="$BASE/www"
OPEN="$WWW/open"

CHROME_BASE="/opt/chrome"
CHROME="$CHROME_BASE/chrome"

DESKTOP="/usr/share/applications/geogebra-local.desktop"

GGB_URL="https://download.geogebra.org/package/geogebra-math-apps-bundle"
CHROME_JSON_URL="https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions-with-downloads.json"

FORCE=false
EXAM_MODE=false


# ============================================================
# Parameter
# ============================================================

for ARG in "$@"; do
   case "$ARG" in
      --force)
         FORCE=true
         ;;

      --exam)
         EXAM_MODE=true
         ;;

      --uninstall)
         if [ "$(id -u)" -ne 0 ]; then
            echo "FEHLER: Dieses Skript muss als root ausgeführt werden."
            exit 1
         fi

         echo "Entferne GeoGebra ..."

         for FILE in /usr/share/applications/*.desktop; do
            [ -f "$FILE" ] || continue

            if grep -q '/opt/geogebra/start.sh' "$FILE"; then
               rm -f "$FILE"
            fi
         done

         rm -rf "$BASE"

         rm -f /usr/share/mime/packages/geogebra-local.xml
         if command -v update-mime-database >/dev/null 2>&1; then
            update-mime-database /usr/share/mime
         fi
         if command -v python3 >/dev/null 2>&1; then
            python3 - <<'PYEOF'
import configparser
from pathlib import Path
path = Path('/etc/xdg/mimeapps.list')
if path.exists():
   config = configparser.ConfigParser(interpolation=None, strict=False)
   config.optionxform = str
   config.read(path)
   section = 'Default Applications'
   key = 'application/vnd.geogebra.file'
   if config.has_section(section) and config[section].get(key) == 'geogebra-local.desktop;':
      config.remove_option(section, key)
      with path.open('w') as output:
         config.write(output)
PYEOF
         fi

         update-desktop-database \
            /usr/share/applications \
            2>/dev/null || true

         echo
         echo "GeoGebra wurde entfernt."
         echo "/opt/chrome wurde beibehalten."

         exit 0
         ;;

      *)
         echo "Unbekannter Parameter: $ARG"
         echo
         echo "Verwendung:"
         echo "   $0"
         echo "   $0 --force"
         echo "   $0 --exam"
         echo "   $0 --exam --force"
         echo "   $0 --uninstall"
         exit 1
         ;;
   esac
done


# ============================================================
# Root
# ============================================================

if [ "$(id -u)" -ne 0 ]; then
   echo "FEHLER: Dieses Skript muss als root ausgeführt werden."
   exit 1
fi


# ============================================================
# Voraussetzungen
# ============================================================

for CMD in curl unzip python3 xprop xwininfo flock update-mime-database update-desktop-database; do
   if ! command -v "$CMD" >/dev/null 2>&1; then
      echo "FEHLER: $CMD fehlt."
      exit 1
   fi
done


TMP="$(mktemp -d /tmp/geogebra-install-XXXXXX)"


cleanup() {
   rm -rf "$TMP"
}


trap cleanup EXIT


mkdir -p "$BASE"


# ============================================================
# Chrome
# ============================================================

if [ "$FORCE" = true ] || [ ! -x "$CHROME" ]; then

   echo
   echo "Ermittle aktuelle Chrome-Stable-Version ..."

   curl -fL \
      "$CHROME_JSON_URL" \
      -o "$TMP/chrome.json"


   CHROME_URL="$(
      python3 -c '
import json
import sys

with open(sys.argv[1], encoding="utf-8") as f:
   data = json.load(f)

for item in data["channels"]["Stable"]["downloads"]["chrome"]:
   if item["platform"] == "linux64":
      print(item["url"])
      break
' "$TMP/chrome.json"
   )"


   if [ -z "$CHROME_URL" ]; then
      echo "FEHLER: Chrome-Download konnte nicht ermittelt werden."
      exit 1
   fi


   echo "Lade Chrome ..."

   curl -fL \
      "$CHROME_URL" \
      -o "$TMP/chrome.zip"


   mkdir "$TMP/chrome"

   unzip -q \
      "$TMP/chrome.zip" \
      -d "$TMP/chrome"


   if [ ! -x "$TMP/chrome/chrome-linux64/chrome" ]; then
      echo "FEHLER: Chrome-Archiv ist unvollständig."
      exit 1
   fi


   rm -rf "$CHROME_BASE"

   mv \
      "$TMP/chrome/chrome-linux64" \
      "$CHROME_BASE"

   chmod -R a+rX "$CHROME_BASE"

else

   echo
   echo "Vorhandenes Chrome wird verwendet."

fi


# ============================================================
# GeoGebra
# ============================================================

if [ "$FORCE" = true ] ||
   [ ! -f "$GGB/GeoGebra/deployggb.js" ]; then

   echo
   echo "Lade GeoGebra Math Apps Bundle ..."

   curl -fL \
      "$GGB_URL" \
      -o "$TMP/geogebra.zip"


   mkdir "$TMP/geogebra"

   unzip -q \
      "$TMP/geogebra.zip" \
      -d "$TMP/geogebra"


   DEPLOY="$(
      find "$TMP/geogebra" \
         -type f \
         -path '*/GeoGebra/deployggb.js' \
         -print \
         -quit
   )"


   if [ -z "$DEPLOY" ]; then
      echo "FEHLER: GeoGebra/deployggb.js wurde nicht gefunden."
      exit 1
   fi


   SOURCE="$(dirname "$(dirname "$DEPLOY")")"


   if [ ! -f "$SOURCE/GeoGebra/HTML5/5.0/web3d/web3d.nocache.js" ]; then
      echo "FEHLER: GeoGebra web3d wurde nicht gefunden."
      exit 1
   fi


   rm -rf "$GGB"

   mkdir -p "$GGB"

   cp -a \
      "$SOURCE/." \
      "$GGB/"


   if [ ! -f "$GGB/GeoGebra/HTML5/5.0/web3d/web3d.nocache.js" ]; then
      echo "FEHLER: GeoGebra-Installation ist unvollständig."
      exit 1
   fi

else

   echo
   echo "Vorhandenes GeoGebra-Bundle wird verwendet."

fi


# ============================================================
# Verzeichnisse
# ============================================================

mkdir -p \
   "$WWW" \
   "$OPEN"

chmod 1777 "$OPEN"


# ============================================================
# Konfiguration
# ============================================================

cat > "$BASE/config" <<EOF
EXAM_MODE=$EXAM_MODE
EOF

chmod 644 "$BASE/config"


# ============================================================
# Lokaler Webserver
#
# WICHTIG:
# /GeoGebra/... zeigt auf
# /opt/geogebra/ggb/GeoGebra/...
# ============================================================

cat > "$BASE/server.py" <<'PYEOF'
#!/usr/bin/env python3

import http.server
import os
import posixpath
import urllib.parse


HOST = "127.0.0.1"
PORT = 8765

WWW_ROOT = "/opt/geogebra/www"
GGB_ROOT = "/opt/geogebra/ggb/GeoGebra"


class GeoGebraHandler(http.server.SimpleHTTPRequestHandler):

   def translate_path(self, path):

      path = urllib.parse.urlparse(path).path
      path = urllib.parse.unquote(path)

      if path == "/GeoGebra":
         path = "/GeoGebra/"

      if path.startswith("/GeoGebra/"):
         root = GGB_ROOT
         relative = path[len("/GeoGebra/"):]
      else:
         root = WWW_ROOT
         relative = path.lstrip("/")

      relative = posixpath.normpath(relative)

      parts = [
         part
         for part in relative.split("/")
         if part not in ("", ".", "..")
      ]

      result = root

      for part in parts:
         result = os.path.join(result, part)

      return result


   def end_headers(self):
      self.send_header(
         "Cache-Control",
         "no-cache, no-store, must-revalidate"
      )
      self.send_header(
         "Pragma",
         "no-cache"
      )
      self.send_header(
         "Expires",
         "0"
      )

      super().end_headers()


   def log_message(self, fmt, *args):
      pass


def main():

   server = http.server.ThreadingHTTPServer(
      (HOST, PORT),
      GeoGebraHandler
   )

   server.serve_forever()


if __name__ == "__main__":
   main()
PYEOF

chmod 755 "$BASE/server.py"


# ============================================================
# index.html
# ============================================================

if [ "$EXAM_MODE" = true ]; then
   ENABLE_3D="false"
else
   ENABLE_3D="true"
fi


cat > "$WWW/index.html" <<EOF
<!DOCTYPE html>

<html lang="de">

<head>

   <meta charset="utf-8">

   <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1"
   >

   <title>GeoGebra</title>


   <style>

      html,
      body {
         margin: 0;
         padding: 0;

         width: 100%;
         height: 100%;

         overflow: hidden;
      }


      body {
         position: fixed;

         top: 0;
         left: 0;

         width: 100%;
         height: 100%;

         color: #666;

         font-size: 14px;
         font-family: sans-serif;

         touch-action: none;

         -webkit-tap-highlight-color:
            rgba(255,255,255,0);
      }


      #ggw {
         position: absolute;

         top: 0;
         left: 0;

         width: 100%;
         height: 100%;
      }


      /*
       * Nativer GeoGebra-Suite-App-Picker.
       *
       * Die Funktionalität stammt von GeoGebra selbst.
       * Wir verändern ausschließlich seine Darstellung
       * und Position.
       */

      #suiteAppPicker {
         position: fixed !important;

         left: 12px !important;
         bottom: 12px !important;

         top: auto !important;
         right: auto !important;

         margin: 0 !important;

         z-index: 2147483000 !important;
      }


      /*
       * Beschriftungen des Auswahlknopfs ausblenden.
       */

      #suiteAppPicker span,
      #suiteAppPicker .gwt-Label {
         display: none !important;
      }


      /*
       * Pfeile / Dropdown-Indikatoren ausblenden.
       */

      #suiteAppPicker svg:not(:first-child),
      #suiteAppPicker [class*="arrow"],
      #suiteAppPicker [class*="Arrow"],
      #suiteAppPicker [class*="chevron"],
      #suiteAppPicker [class*="Chevron"],
      #suiteAppPicker [class*="dropdown"],
      #suiteAppPicker [class*="Dropdown"] {
         display: none !important;
      }


      /*
       * Der sichtbare Hauptknopf soll nur das Icon zeigen.
       */

      #suiteAppPicker button {
         min-width: 48px !important;
         width: 48px !important;

         min-height: 48px !important;
         height: 48px !important;

         padding: 6px !important;

         overflow: hidden !important;
      }


      #suiteAppPicker img {
         width: 36px !important;
         height: 36px !important;

         object-fit: contain !important;
      }

   </style>


   <script>

      var appID = "suite";

      var module = "web3d";

      var codebase =
         "/GeoGebra/HTML5/5.0/";


      var defaultParams = {

         vendor: "GeoGebra",

         preloadModules: "",

         marginTop: 0,

         language: "de",

         enableCAS: true,

         enable3d: $ENABLE_3D,

         enableFileFeatures: true,

         showAppsPicker: true

      };

      // Das vollständige GGB-Archiv enthält auch Bilder und Skripte.
      // Das persistente Chrome-Profil hält diesen Speicher über Neustarts.
      const SESSION_KEY = "geogebra-local:last-document:v1";
      let sessionApplet = null;
      let restoringSession = false;
      let lastOpenRequest = getURLParam("request");
      let openingFile = false;

      async function checkOpenRequest() {
         const user = getURLParam("user");
         if (!user || !sessionApplet || openingFile || restoringSession) return;
         try {
            const response = await fetch("/open/" + user + "-request.json", {cache: "no-store"});
            if (!response.ok) return;
            const request = await response.json();
            if (request.id === lastOpenRequest) return;
            lastOpenRequest = request.id;
            if (!request.file) return;
            saveSession();
            openingFile = true;
            restoringSession = true;
            const fileResponse = await fetch(request.file, {cache: "no-store"});
            if (!fileResponse.ok) throw new Error("Dateiabruf fehlgeschlagen");
            const bytes = new Uint8Array(await fileResponse.arrayBuffer());
            let binary = "";
            for (let offset = 0; offset < bytes.length; offset += 8192) {
               binary += String.fromCharCode(...bytes.subarray(offset, offset + 8192));
            }
            sessionApplet.setBase64(btoa(binary), function() {
               openingFile = false;
               restoringSession = false;
               saveSession();
            });
         } catch (error) {
            openingFile = false;
            restoringSession = false;
            console.error("GeoGebra konnte die angeforderte Datei nicht öffnen", error);
         }
      }

      function saveSession() {
         if (!sessionApplet || restoringSession) return;
         try {
            const archive = sessionApplet.getBase64();
            if (archive) localStorage.setItem(SESSION_KEY, archive);
         } catch (error) {
            console.error("GeoGebra konnte den Bearbeitungsstand nicht speichern", error);
            document.title = "GeoGebra – automatische Speicherung fehlgeschlagen";
         }
      }

      window.ggbOnInit = function(name, api) {
         sessionApplet = api || window[name] || window.ggbApplet;
         if (!sessionApplet) return;
         try {
            const archive = localStorage.getItem(SESSION_KEY);
            // Eine ausdrücklich geöffnete Datei hat Vorrang vor der Sitzung.
            if (archive && !getURLParam("file")) {
               restoringSession = true;
               sessionApplet.setBase64(archive, function() {
                  restoringSession = false;
               });
            }
         } catch (error) {
            restoringSession = false;
            console.error("GeoGebra konnte den Bearbeitungsstand nicht laden", error);
         }
         for (const method of ["registerAddListener", "registerRemoveListener",
                               "registerUpdateListener", "registerClearListener",
                               "registerClientListener"]) {
            if (typeof sessionApplet[method] === "function") {
               sessionApplet[method](saveSession);
            }
         }
         setInterval(saveSession, 2000);
         setInterval(checkOpenRequest, 1000);
         window.addEventListener("pagehide", saveSession);
         window.addEventListener("beforeunload", saveSession);
      };


      /*
       * Die sechs vom Benutzer gelieferten Originalsymbole.
       */

      const APP_ICONS = {

         graphing:
            "data:image/svg+xml;base64,",

         "3d":
            "data:image/svg+xml;base64,",

         geometry:
            "data:image/svg+xml;base64,",

         cas:
            "data:image/svg+xml;base64,",

         probability:
            "data:image/svg+xml;base64,",

         scientific:
            "data:image/svg+xml;base64,"

      };


      function setParam(name, value) {

         document
            .getElementById("ggw")
            .setAttribute(
               "data-param-" + name,
               value
            );

      }


      function getURLParam(name) {

         return new URLSearchParams(
            window.location.search
         ).get(name);

      }


      function configure() {
         const params = Object.assign({}, defaultParams, {
            id: "ggbApplet",
            appName: appID,
            randomize: false,
            appletOnLoad: function(api) {
               window.ggbOnInit("ggbApplet", api);
            }
         });
         const filename = getURLParam("file");
         if (filename) params.filename = filename;
         return params;
      }


      /*
       * Nur die Darstellung des nativen Pickers verändern.
       *
       * Die GeoGebra-Eventhandler bleiben unangetastet.
       */

      function simplifySuitePicker() {

         const picker =
            document.getElementById(
               "suiteAppPicker"
            );


         if (!picker) {
            return;
         }


         /*
          * Alle Texte ausblenden.
          */

         picker
            .querySelectorAll(
               "span, .gwt-Label"
            )
            .forEach(
               function(element) {
                  element.style.display =
                     "none";
               }
            );


         /*
          * Wenn GeoGebra seine Modi über Elemente mit
          * erkennbaren Titeln/aria-labels erzeugt, ersetzen
          * wir ausschließlich das sichtbare Icon.
          */

         picker
            .querySelectorAll(
               "[title], [aria-label]"
            )
            .forEach(
               function(element) {

                  const label = (
                     element.getAttribute(
                        "title"
                     ) ||
                     element.getAttribute(
                        "aria-label"
                     ) ||
                     ""
                  ).toLowerCase();


                  let icon = null;


                  if (
                     label.includes("graph") ||
                     label.includes("graf")
                  ) {
                     icon =
                        APP_ICONS.graphing;
                  }
                  else if (
                     label.includes("3d")
                  ) {
                     icon =
                        APP_ICONS["3d"];
                  }
                  else if (
                     label.includes("geo")
                  ) {
                     icon =
                        APP_ICONS.geometry;
                  }
                  else if (
                     label.includes("cas")
                  ) {
                     icon =
                        APP_ICONS.cas;
                  }
                  else if (
                     label.includes("prob") ||
                     label.includes("wahrschein")
                  ) {
                     icon =
                        APP_ICONS.probability;
                  }
                  else if (
                     label.includes("scient") ||
                     label.includes("taschen")
                  ) {
                     icon =
                        APP_ICONS.scientific;
                  }


                  if (!icon) {
                     return;
                  }


                  let image =
                     element.querySelector(
                        "img"
                     );


                  if (!image) {

                     image =
                        document.createElement(
                           "img"
                        );

                     element.insertBefore(
                        image,
                        element.firstChild
                     );

                  }


                  image.src = icon;

                  image.style.width =
                     "36px";

                  image.style.height =
                     "36px";

               }
            );

      }


      /*
       * Der Picker wird von GWT erst nachträglich erzeugt.
       * MutationObserver reagiert darauf ohne Polling,
       * sleep oder künstliche Wartezeit.
       */

      const pickerObserver =
         new MutationObserver(
            function() {
               simplifySuitePicker();
            }
         );


      function loadGeoGebra() {

         pickerObserver.observe(
            document.body,
            {
               childList: true,
               subtree: true
            }
         );


         const script =
            document.createElement(
               "script"
            );


         script.src = "/GeoGebra/deployggb.js";
         script.onload = function() {
            const applet = new GGBApplet(configure(), true);
            applet.setHTML5Codebase(codebase + module + "/");
            applet.inject("ggw");
         };

         document.head.appendChild(
            script
         );

      }


      window.addEventListener(
         "load",
         loadGeoGebra
      );

   </script>

</head>


<body
   dir="ltr"
   tabindex="-1"
>

   <div
      id="ggw"
      class="geogebraweb"
      data-param-app="true"
   ></div>

   <div id="suiteAppPicker"></div>

</body>

</html>
EOF


